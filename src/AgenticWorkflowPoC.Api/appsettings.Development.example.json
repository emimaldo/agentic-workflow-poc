{
    "Ollama": {
        "Model": "llama3.1",
        "Endpoint": "http://localhost:11434"
    },
    "ConnectionStrings": {
        "AgenticDatabase": "Server=localhost,1433;Database=AgenticPoC;User Id=sa;Password=<MSSQL_SA_PASSWORD from docker-compose.yml>;TrustServerCertificate=True;"
    },
    "Authentication": {
        "ApiKeys": [
            {
                "Key": "replace-with-a-local-secret",
                "TenantId": "tenant-local",
                "Role": "Admin",
                "Subject": "local-operator"
            }
        ]
    },
    "TenantPolicies": {
        "tenant-local": {
            "OperatingAccountId": "OPS-EUR-001",
            "HitlThreshold": 10000,
            "MaxPerTransfer": 100000,
            "DailyLimit": 60000,
            "AllowedCurrencies": [
                "EUR"
            ]
        }
    },
    "DevLedger": {
        "Accounts": [
            {
                "TenantId": "tenant-local",
                "AccountId": "OPS-EUR-001",
                "Currency": "EUR",
                "Balance": 50000
            }
        ]
    }
}
